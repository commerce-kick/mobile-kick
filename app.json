{
  "expo": {
    "name": "mob-kit",
    "slug": "mob-kit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bootsplash/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "appleTeamId": "aaaaaaaaaaaa",
      "supportsTablet": false,
      "bundleIdentifier": "com.fervillanuevas.mob-kit",
      "entitlements": {
        "com.apple.security.application-groups": ["group.fervillanuevas.data"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/app.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fervillanuevas.mobkit"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["react-native-bootsplash", { "assetsDir": "assets/bootsplash" }],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {},
        "projectId": "aaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    }
  }
}
